.gitignore
.dockerignore
.claude
.idea
.vscode
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.playwright-mcp

data/
tests/
docs/
*.md
pytest.ini
requirements-dev.txt
requirements-postgres.txt
