worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events { worker_connections 256; }

http {
    access_log off;

    server {
        listen 8099;

        # This proxy adds the dashboard credentials, so only Home Assistant may
        # connect: the Supervisor's ingress gateway (the sidebar panel) and Core
        # (rest sensors and rest_command, so the token lives only in this
        # add-on's options, not in secrets.yaml). Anyone else is refused.
        allow 172.30.32.2;   # Supervisor (ingress)
        allow 172.30.32.1;   # Home Assistant Core
        deny all;

        location / {
            proxy_pass @UPSTREAM@;
            proxy_set_header Host $proxy_host;
            proxy_set_header Authorization "Basic @AUTH@";

            # The dashboard prefixes its links, forms, API calls and redirects
            # with this path, so everything stays under the ingress URL.
            proxy_set_header X-Ingress-Path $http_x_ingress_path;

            # Redirects already carry the ingress prefix; leave them as they are.
            proxy_redirect off;

            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
        }
    }
}
